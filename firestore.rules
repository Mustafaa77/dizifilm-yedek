rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isActive() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isApprovedUser() {
      return isActive()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['approved', 'admin'];
    }

    function isAdmin() {
      return isActive()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUsername(username) {
      return username is string
        && username.matches('^[a-z0-9_]{3,20}$');
    }

    match /users/{userId} {
      allow get, read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == 'pending'
        && request.resource.data.status == 'active'
        && ('userId' in request.resource.data)
        && request.resource.data.userId == userId
        && ('username' in request.resource.data)
        && isValidUsername(request.resource.data.username);
      allow update: if (isOwner(userId) || isAdmin())
        && !(('role' in request.writeFields && !isAdmin()))
        && !(('status' in request.writeFields && !isAdmin()))
        && (('username' in request.writeFields) ? isValidUsername(request.resource.data.username) : true);
      allow delete: if isAdmin();
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.username == username
        && isValidUsername(username);
      allow delete: if isOwner(request.resource.data.userId) || isAdmin();
    }

    match /user_media_lists/{listId} {
      allow get, read: if isOwner(resource.data.userId) || isAdmin();
      allow list: if request.auth != null && request.auth.uid == request.query.userId || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isApprovedUser();
      allow update: if (isOwner(resource.data.userId) || isAdmin())
        && isApprovedUser();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isApprovedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 10
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 4000;
      allow update: if isAdmin()
        && ('reported' in request.writeFields
            || 'status' in request.writeFields
            || 'updatedAt' in request.writeFields);
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /movies/{movieId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /watchparties/{partyId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if isApprovedUser()
        && (resource.data.hostId == request.auth.uid || request.auth.uid in resource.data.participants);
    }
  }
}
